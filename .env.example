ROOM_NAME=Living Room Speaker           # Sonos speaker room name
MQTT_HOST=mqtt://mqtt.example.com:1883  # MQTT broker URL
MQTT_USER=your_mqtt_username            # MQTT username
MQTT_PASSWORD=your_mqtt_password        # MQTT password
LOG_LEVEL=info                          # Log level (trace, debug, info, warn, error)
PORT=8080                               # HTTP server port